# Copy to .env and export these before running in production.
NODE_ENV=production
PORT=4000
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=247a406f767438bd7dfa61db0ae4985e
# Initial admin account, created on first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AntivenomSerum@12345
# Set to false only if you serve over plain http (not recommended).
COOKIE_SECURE=true
# Set to true when running behind a reverse proxy such as nginx.
TRUST_PROXY=false
# Fewer vials than this is shown as "Low stock".
LOW_STOCK_THRESHOLD=20
# Where the database and uploaded files are kept.
DATA_DIR=./server/data
